<?xml version="1.0" encoding="UTF-8"?>
<configuration>
<property name="log_folder" value="./log"/>
<appender name="file" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${log_folder}/app.log</file>
    <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
        <charset>UTF-8</charset>
        <Pattern>%d{yyyy-MM-dd HH:mm:ss} - %msg%n</Pattern>
    </encoder>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
        <fileNamePattern>${log_folder}/archived/app.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
        <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
            <maxFileSize>10MB</maxFileSize>
        </timeBasedFileNamingAndTriggeringPolicy>
    </rollingPolicy>
</appender>
<appender name="console" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
        <charset>UTF-8</charset>
        <Pattern>%d{HH:mm:ss} %-5level %logger{36}:%L - %msg%n</Pattern>
    </encoder>
</appender>




    <Logger name="com.task.log" level="INFO" additivity="false">
        <appender-ref ref="file"/>
        <appender-ref ref="console"/>

    </Logger>
    <Logger name="com.task.log" level="DEBUG" additivity="false">
        <appender-ref ref="file"/>
        <appender-ref ref="console"/>

    </Logger>
    <root level="WARN">
        <appender-ref ref="file"/>
        <appender-ref ref="console"/>
    </root>
</configuration>